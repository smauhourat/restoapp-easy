# PostgreSQL local (el de la maquina, puerto 5433). Si usas el contenedor de
# docker-compose, cambia el puerto a 5434.
DATABASE_URL="postgresql://resto:resto@localhost:5433/restoapp?schema=public"

# Prisma necesita una shadow database para migrate dev. Normalmente la crea y
# la borra sola, pero PostgreSQL 11 no soporta DROP DATABASE ... WITH (FORCE)
# -- esa sintaxis existe desde PG 13. Con la shadow declarada a mano, Prisma
# la reutiliza en vez de recrearla.
SHADOW_DATABASE_URL="postgresql://resto:resto@localhost:5433/restoapp_shadow?schema=public"

# Secreto de firma de los tokens. En desarrollo se genera uno al azar por
# arranque si falta, lo que invalida las sesiones en cada reinicio.
JWT_SECRET=""

PORT=3001
NOMBRE_RESTAURANTE="Mi Restaurante"
